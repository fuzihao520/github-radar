{
  "_说明": "采集器配置。改这里就能换仓库清单来源，不用动代码。",

  "discovery": {
    "mode": "topic",

    "_mode说明": "topic = 按 topic 标签找；stars = 按全局 star 排行找；both = 两者合并去重",

    "topics": ["ai", "llm", "agent", "mcp", "rag", "llmops", "ai-agents"],

    "minStars": 500,
    "pushedWithinDays": 90,
    "perQuery": 40,
    "maxRepos": 120
  },

  "scope": {
    "min_stars": 500,
    "active_within_years": 1
  },

  "knownThreshold": 50000,

  "fetch": {
    "searchDelayMs": 2200,
    "releasePerRepo": true,
    "releaseMax": 60,
    "timeoutMs": 20000,
    "retries": 3
  },

  "history": {
    "keepDays": 120
  }
}
